#!/usr/bin/env bash
# Amp Orb setup script (LOAF-78). Runs once when a fresh orb is prepared.
# Installs the pinned development toolchain, warms dependencies, builds the
# Loaf CLI, then project-environment `loaf install --to amp`.
# Project attach token (LOAF-67): set LOAF_CLIENT_TOKEN from
# `loaf auth link --project` via amp secrets / project environment.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GO_VERSION=1.27.1
NODE_VERSION=24.21.0
TOOL_ROOT="$HOME/.local/share/loaf-orb"
PROFILE="$HOME/.bash_profile"
ENV_FILE="$TOOL_ROOT/env"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Required command not found: %s\n' "$1" >&2
    return 1
  }
}

verify_sha256() {
  local expected="$1"
  local archive="$2"
  printf '%s  %s\n' "$expected" "$archive" | sha256sum --check --status
}

install_linux_toolchains() {
  local machine go_arch node_arch go_sha node_sha
  machine="$(uname -m)"
  case "$machine" in
    x86_64)
      go_arch=amd64
      node_arch=x64
      go_sha=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
      node_sha=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
      ;;
    aarch64|arm64)
      go_arch=arm64
      node_arch=arm64
      go_sha=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec
      node_sha=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5
      ;;
    *)
      printf 'Unsupported Orb architecture: %s\n' "$machine" >&2
      return 1
      ;;
  esac

  mkdir -p "$TOOL_ROOT"
  local provided_go
  provided_go="$(command -v go || true)"
  if [[ -n "$provided_go" && "$("$provided_go" version 2>/dev/null || true)" == "go version go${GO_VERSION} linux/${go_arch}" ]]; then
    GO_ROOT="$(cd "$(dirname "$provided_go")/.." && pwd)"
  else
    GO_ROOT="$TOOL_ROOT/go-$GO_VERSION"
  fi

  if [[ "$GO_ROOT" == "$TOOL_ROOT/go-$GO_VERSION" ]] &&
    { [[ ! -x "$GO_ROOT/bin/go" ]] || [[ "$("$GO_ROOT/bin/go" version 2>/dev/null || true)" != "go version go${GO_VERSION} linux/${go_arch}" ]]; }; then
    local go_archive go_stage
    printf 'Downloading Go %s for linux/%s\n' "$GO_VERSION" "$go_arch"
    go_archive="$(mktemp "$TOOL_ROOT/go.XXXXXX.tar.gz")"
    go_stage="$(mktemp -d "$TOOL_ROOT/go.XXXXXX")"
    curl --fail --location --silent --show-error \
      "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" \
      --output "$go_archive"
    verify_sha256 "$go_sha" "$go_archive"
    tar -xzf "$go_archive" -C "$go_stage"
    rm -rf "$GO_ROOT"
    mv "$go_stage/go" "$GO_ROOT"
    rm -rf "$go_stage" "$go_archive"
  fi

  local provided_node
  provided_node="$(command -v node || true)"
  if [[ -n "$provided_node" && "$("$provided_node" -p 'Number.parseInt(process.versions.node, 10) >= 24' 2>/dev/null || true)" == true ]]; then
    NODE_ROOT="$(cd "$(dirname "$provided_node")/.." && pwd)"
  else
    NODE_ROOT="$TOOL_ROOT/node-$NODE_VERSION"
  fi

  if [[ "$NODE_ROOT" == "$TOOL_ROOT/node-$NODE_VERSION" ]] &&
    { [[ ! -x "$NODE_ROOT/bin/node" ]] || [[ "$("$NODE_ROOT/bin/node" --version 2>/dev/null || true)" != "v$NODE_VERSION" ]]; }; then
    local node_archive node_stage
    printf 'Downloading Node.js %s for linux/%s\n' "$NODE_VERSION" "$node_arch"
    node_archive="$(mktemp "$TOOL_ROOT/node.XXXXXX.tar.gz")"
    node_stage="$(mktemp -d "$TOOL_ROOT/node.XXXXXX")"
    curl --fail --location --silent --show-error \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.gz" \
      --output "$node_archive"
    verify_sha256 "$node_sha" "$node_archive"
    tar -xzf "$node_archive" -C "$node_stage" --strip-components=1
    rm -rf "$NODE_ROOT"
    mv "$node_stage" "$NODE_ROOT"
    rm -f "$node_archive"
  fi
}

configure_toolchain() {
  if [[ "$(uname -s)" == Linux ]]; then
    if ! command -v curl >/dev/null || ! command -v sha256sum >/dev/null || ! command -v tar >/dev/null; then
      sudo apt-get update -qq
      sudo apt-get install -y curl ca-certificates coreutils tar
    fi
    install_linux_toolchains
  else
    require_command go
    require_command node
    GO_ROOT="$(cd "$(dirname "$(command -v go)")/.." && pwd)"
    NODE_ROOT="$(cd "$(dirname "$(command -v node)")/.." && pwd)"
    if [[ "$(node -p 'Number.parseInt(process.versions.node, 10) >= 24')" != true ]]; then
      printf 'Loaf development requires Node 24 or later on PATH.\n' >&2
      return 1
    fi
  fi

  export PATH="$GO_ROOT/bin:$NODE_ROOT/bin:$PATH"
  mkdir -p "$TOOL_ROOT"

  cat > "$ENV_FILE" <<EOF
export PATH="$ROOT/bin:$GO_ROOT/bin:$NODE_ROOT/bin:\$PATH"
EOF

  # Bash reads only the first login profile it finds. Keep the Orb image's
  # existing initialization instead of creating a higher-priority file.
  local login_profile
  for login_profile in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
    if [[ -e "$login_profile" ]]; then
      PROFILE="$login_profile"
      break
    fi
  done

  local marker='# Orb development toolchain for Loaf'
  if ! grep -Fqx "$marker" "$PROFILE" 2>/dev/null; then
    mkdir -p "$(dirname "$PROFILE")"
    cat >> "$PROFILE" <<EOF

$marker
if [ "\${PWD:-}" = "$ROOT" ] && [ -r "$ENV_FILE" ]; then
  . "$ENV_FILE"
fi
EOF
  fi
}

if ! grep -Fqx "toolchain go$GO_VERSION" go.mod; then
  printf 'Update .agents/setup for the Go toolchain declared in go.mod.\n' >&2
  exit 1
fi

step "Configure Go and Node.js" configure_toolchain
step "Download Go modules" go mod download

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$arch" in
  x86_64) arch=x64 ;;
  aarch64|arm64) arch=arm64 ;;
esac
NATIVE="$ROOT/bin/native/${os}-${arch}/loaf"
BUILD_MARKER="$ROOT/bin/.orb-build-commit"
SOURCE_COMMIT="$(git rev-parse HEAD)"

# A stale Orb snapshot can retain an executable from an older checkout. Rebuild
# only when either executable is absent or its recorded source commit changed.
if [[ ! -x "$ROOT/bin/loaf" || ! -x "$NATIVE" || ! -f "$BUILD_MARKER" ]] || \
  [[ "$(cat "$BUILD_MARKER" 2>/dev/null || true)" != "$SOURCE_COMMIT" ]]; then
  step "Build Loaf CLI" go run ./cmd/loafdev build-go
  printf '%s\n' "$SOURCE_COMMIT" > "$BUILD_MARKER"
else
  printf '==> Loaf CLI already built for %s\n' "${SOURCE_COMMIT:0:12}"
fi

export PATH="$ROOT/bin:$PATH"
export LOAF_PROJECT_ENV=1
step "Install Amp project environment" loaf install --to amp --yes
