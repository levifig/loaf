{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "StrReplace|Write|Shell",
        "failClosed": true,
        "command": "loaf check --hook artifact-body-write --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "StrReplace|Write|Shell",
        "failClosed": true,
        "command": "loaf check --hook check-secrets --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 600,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook security-audit --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook validate-infra-safety --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook validate-sql-safety --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook render-drift --json --cursor-hook",
        "if": "Bash(git push:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook ephemeral-provenance --json --cursor-hook",
        "if": "Bash(git push:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook artifact-names --json --cursor-hook",
        "if": "Bash(git commit:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 10,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook github-account --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 60,
        "matcher": "Shell",
        "command": "loaf check --hook validate-push --advisory --json --cursor-hook",
        "if": "Bash(git push:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 5,
        "matcher": "Shell",
        "command": "loaf check --hook workflow-pre-pr --advisory --json --cursor-hook",
        "if": "Bash(gh pr create:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 5,
        "matcher": "Bash",
        "command": "cat \"$HOME/.cursor/hooks/instructions/pre-merge.md\"",
        "if": "Bash(gh pr merge:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 5,
        "matcher": "Bash",
        "command": "cat \"$HOME/.cursor/hooks/instructions/pre-push.md\"",
        "if": "Bash(git push:*)"
      },
      {
        "loaf-managed": true,
        "timeout": 30,
        "matcher": "Shell",
        "failClosed": true,
        "command": "loaf check --hook validate-commit --json --cursor-hook",
        "if": "Bash(git commit:*)"
      }
    ],
    "postToolUse": [
      {
        "loaf-managed": true,
        "timeout": 5,
        "matcher": "StrReplace|Write",
        "command": "loaf check --hook kb-staleness-nudge --json --cursor-hook"
      },
      {
        "loaf-managed": true,
        "timeout": 5,
        "matcher": "Bash",
        "command": "cat \"$HOME/.cursor/hooks/instructions/post-merge.md\"",
        "if": "Bash(gh pr merge:*)"
      }
    ],
    "sessionStart": [
      {
        "loaf-managed": true,
        "timeout": 60,
        "command": "loaf journal context --from-hook --cursor-hook"
      }
    ]
  }
}