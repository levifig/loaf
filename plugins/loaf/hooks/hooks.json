{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "loaf check --hook artifact-body-write",
            "timeout": 30,
            "description": "Block direct .agents artifact body writes that bypass SQLite registration",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook check-secrets",
            "timeout": 30,
            "description": "Check for hardcoded secrets before writing",
            "failClosed": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "loaf check --hook security-audit",
            "timeout": 600,
            "description": "Run security audit on bash commands",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook validate-infra-safety",
            "timeout": 30,
            "description": "Block destructive kubectl, terraform, docker, helm, and rm -rf system-path commands",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook validate-sql-safety",
            "timeout": 30,
            "description": "Block DROP/TRUNCATE and warn on DELETE without WHERE or DROP COLUMN",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook render-drift",
            "if": "Bash(git push:*)",
            "timeout": 30,
            "description": "Validate stamped durable renders are self-consistent before push",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook ephemeral-provenance",
            "if": "Bash(git push:*)",
            "timeout": 30,
            "description": "Block tracked ephemeral Markdown and dangling references from retained spec records",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook artifact-names",
            "if": "Bash(git commit:*)",
            "timeout": 30,
            "description": "Block artifact filenames that name the work unit that produced them",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook github-account",
            "timeout": 10,
            "description": "Switch the active GitHub account to project config before gh commands; block only if the switch fails",
            "failClosed": true
          },
          {
            "type": "command",
            "command": "loaf check --hook validate-push --advisory",
            "if": "Bash(git push:*)",
            "timeout": 60,
            "description": "Validates version bump, CHANGELOG, and build before git push"
          },
          {
            "type": "command",
            "command": "loaf check --hook workflow-pre-pr --advisory",
            "if": "Bash(gh pr create:*)",
            "timeout": 5,
            "description": "Remind about PR format and CHANGELOG entry before gh pr create"
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/instructions/pre-merge.md\"",
            "if": "Bash(gh pr merge:*)",
            "timeout": 5,
            "description": "Remind about squash merge conventions before gh pr merge"
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/instructions/pre-push.md\"",
            "if": "Bash(git push:*)",
            "timeout": 5,
            "description": "Advisory reminders before git push"
          },
          {
            "type": "command",
            "command": "loaf check --hook validate-commit",
            "if": "Bash(git commit:*)",
            "timeout": 30,
            "description": "Validate commit messages follow conventions",
            "failClosed": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "loaf check --hook kb-staleness-nudge",
            "description": "Track covered edits and nudge when covered knowledge is stale",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/instructions/post-merge.md\"",
            "if": "Bash(gh pr merge:*)",
            "description": "Inject native tracker readback, direct Git worktree cleanup, and journal housekeeping after a gh pr merge hook; command matching does not prove success",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "description": "Emit the layered continuity digest at conversation start",
            "command": "loaf journal context --from-hook --claude-code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "description": "Inject implementation conventions on prompt submit",
            "command": "loaf journal context for-prompt"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "description": "Inject journal flush guidance before compaction",
            "command": "loaf journal context for-compact"
          }
        ]
      }
    ]
  }
}